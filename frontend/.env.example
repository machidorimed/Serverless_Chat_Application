# `terraform apply` 後に `terraform output` で得られる値をここへ設定し、
# このファイルを `.env` としてコピーしてから `npm run build` を実行してください。
# いずれも機密情報ではありません(公開バンドルに含まれます)。

VITE_WEBSOCKET_URL=wss://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com/prod
VITE_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_AWS_REGION=ap-northeast-1
